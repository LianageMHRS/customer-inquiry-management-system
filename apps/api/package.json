{
  "name": "@customer-inquiry/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --database-url-var MIGRATION_DATABASE_URL --envPath .env",
    "db:migrate:test": "node-pg-migrate up --migrations-dir migrations --database-url-var TEST_MIGRATION_DATABASE_URL --envPath .env"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
