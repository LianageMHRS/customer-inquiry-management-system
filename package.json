{
  "name": "customer-inquiry-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace=@customer-inquiry/api",
    "dev:web": "npm run dev --workspace=@customer-inquiry/web",
    "db:migrate": "npm run db:migrate --workspace=@customer-inquiry/api",
    "db:migrate:test": "npm run db:migrate:test --workspace=@customer-inquiry/api",
    "db:seed": "npm run db:seed --workspace=@customer-inquiry/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,md,css,html}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
